{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decisions.schema.json",
  "title": "a choice only the user can make, asked during the run without stopping it; the coordinator rewrites the line as its status changes",
  "x-files": ["decisions.jsonl"],
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "at", "by", "id", "asked", "default", "deadline", "status"],
  "properties": {
    "type": {"const": "decision"},
    "at": {"$ref": "base.schema.json#/$defs/at"},
    "by": {"$ref": "base.schema.json#/$defs/by"},
    "id": {"type": "string", "pattern": "^D\\d+$"},
    "asked": {"type": "string", "minLength": 1},
    "default": {"type": "string", "minLength": 1},
    "deadline": {"$ref": "base.schema.json#/$defs/at"},
    "status": {"enum": ["pending", "default", "changed"]},
    "answer": {
      "description": "the user's answer: the page event that carried it, or their words from the chat",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "event"],
          "properties": {
            "type": {"const": "page"},
            "event": {"type": "string", "x-points-to": {"file": "conversation.jsonl", "type": "answer"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text"],
          "properties": {
            "type": {"const": "chat"},
            "text": {"type": "string", "minLength": 1}
          }
        }
      ]
    }
  },
  "if": {"required": ["status"], "properties": {"status": {"const": "changed"}}},
  "then": {"required": ["answer"]},
  "else": {"not": {"required": ["answer"]}}
}
