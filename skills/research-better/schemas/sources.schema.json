{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sources.schema.json",
  "title": "one page read: its citation, its trust level, and whether it repeats another source; never deleted, a duplicate is marked",
  "x-files": ["sources/*.json"],
  "x-id-from-filename": true,
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "at", "by", "id", "author", "date", "title", "publisher", "url", "ids", "category", "read", "trust", "trust_reason", "repeats", "status"],
  "properties": {
    "type": {"const": "source"},
    "at": {"$ref": "base.schema.json#/$defs/at"},
    "by": {"$ref": "base.schema.json#/$defs/by"},
    "id": {"type": "string", "pattern": "^S-[\\w.-]+-\\d+$"},
    "author": {"type": "string", "minLength": 1},
    "date": {"description": "2024, 2024-03, 2024-03-01 or n.d.", "type": "string", "pattern": "^(\\d{4}(-\\d{2}(-\\d{2})?)?|n\\.d\\.)$"},
    "title": {"type": "string", "minLength": 1},
    "publisher": {"type": "string", "minLength": 1},
    "url": {"type": "string", "minLength": 1},
    "ids": {
      "description": "the identifiers a retraction check can look the work up by",
      "type": "array",
      "items": {
        "anyOf": [
          {"type": "object", "additionalProperties": false, "required": ["type", "doi"], "properties": {"type": {"const": "doi"}, "doi": {"type": "string", "minLength": 1}}},
          {"type": "object", "additionalProperties": false, "required": ["type", "arxiv"], "properties": {"type": {"const": "arxiv"}, "arxiv": {"type": "string", "minLength": 1}}},
          {"type": "object", "additionalProperties": false, "required": ["type", "pmid"], "properties": {"type": {"const": "pmid"}, "pmid": {"type": "string", "minLength": 1}}},
          {"type": "object", "additionalProperties": false, "required": ["type", "isbn"], "properties": {"type": {"const": "isbn"}, "isbn": {"type": "string", "minLength": 1}}}
        ]
      }
    },
    "category": {"enum": ["peer-reviewed", "preprint", "working paper", "dataset", "government", "news", "book", "documentation", "blog", "vendor", "other"]},
    "read": {"enum": ["raw", "extracted", "abstract", "snippet", "blocked"]},
    "trust": {"enum": ["high", "medium", "low"]},
    "trust_reason": {"type": "string", "minLength": 1},
    "repeats": {"type": ["string", "null"], "x-points-to": {"file": "../sources/", "type": "source"}},
    "status": {"enum": ["kept", "duplicate"]},
    "replaced_by": {"type": "string", "x-points-to": {"file": "../sources/", "type": "source"}}
  },
  "if": {"required": ["status"], "properties": {"status": {"const": "duplicate"}}},
  "then": {"required": ["replaced_by"]},
  "else": {"not": {"required": ["replaced_by"]}}
}
