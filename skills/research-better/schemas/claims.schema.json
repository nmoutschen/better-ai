{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claims.schema.json",
  "title": "one claim: a sentence tied to a verbatim quote from one source, for one question; never deleted, a wrong or duplicate claim is withdrawn",
  "x-files": [
    "claims/*.json"
  ],
  "x-id-from-filename": true,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "at",
    "by",
    "id",
    "claim",
    "question",
    "source",
    "quote",
    "status"
  ],
  "properties": {
    "type": {
      "const": "claim"
    },
    "at": {
      "$ref": "base.schema.json#/$defs/at"
    },
    "by": {
      "$ref": "base.schema.json#/$defs/by"
    },
    "id": {
      "type": "string",
      "pattern": "^C-[\\w.-]+-\\d+$"
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "x-points-to": {
        "file": "../questions/",
        "type": "question"
      }
    },
    "source": {
      "type": "string",
      "x-points-to": {
        "file": "../sources/",
        "type": "source"
      }
    },
    "quote": {
      "description": "verbatim",
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "unchecked",
        "checking",
        "verified",
        "unverified",
        "withdrawn"
      ]
    },
    "checker": {
      "description": "the verifier; never the agent that wrote the claim",
      "type": "string",
      "minLength": 1,
      "x-differs-from": "by"
    },
    "span": {
      "description": "the passage the verifier copied from the page",
      "type": "string",
      "minLength": 1
    },
    "blocked": {
      "description": "the page could not be read",
      "type": "boolean"
    },
    "hard": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "differs": {
      "description": "the source fields that differ from the page",
      "type": "string",
      "minLength": 1
    },
    "replaced_by": {
      "type": [
        "string",
        "null"
      ],
      "x-points-to": {
        "file": "../claims/",
        "type": "claim"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "checking",
              "verified",
              "unverified"
            ]
          }
        }
      },
      "then": {
        "required": [
          "checker"
        ]
      },
      "else": {
        "not": {
          "required": [
            "checker"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "verified",
              "unverified"
            ]
          }
        }
      },
      "then": {
        "required": [
          "hard"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "hard"
              ]
            },
            {
              "required": [
                "span"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "verified"
          }
        }
      },
      "then": {
        "required": [
          "span"
        ]
      }
    },
    {
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "unverified"
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "reason"
              ]
            },
            {
              "required": [
                "blocked"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "verified"
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "differs"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "withdrawn"
          }
        }
      },
      "then": {
        "required": [
          "replaced_by"
        ]
      },
      "else": {
        "not": {
          "required": [
            "replaced_by"
          ]
        }
      }
    }
  ]
}