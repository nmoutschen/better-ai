{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decisions.schema.json",
  "title": "one line of decisions.jsonl: a decision with the requirements that drive it and the options it rejected",
  "x-files": [
    "decisions.jsonl"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "at",
    "by",
    "id",
    "title",
    "drivers",
    "chosen",
    "rejected",
    "drawback"
  ],
  "properties": {
    "type": {
      "const": "decision"
    },
    "at": {
      "$ref": "base.schema.json#/$defs/at"
    },
    "by": {
      "$ref": "base.schema.json#/$defs/by"
    },
    "id": {
      "$ref": "base.schema.json#/$defs/id",
      "pattern": "^D\\d+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "drivers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "x-points-to": {
          "file": "requirements.jsonl",
          "type": "requirement"
        }
      }
    },
    "chosen": {
      "type": "string",
      "minLength": 1
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "option",
          "why"
        ],
        "properties": {
          "option": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "drawback": {
      "type": "string",
      "minLength": 1
    }
  }
}
