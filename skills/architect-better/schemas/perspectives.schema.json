{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "perspectives.schema.json",
  "title": "one line of perspectives.jsonl: a perspective the design is reviewed from",
  "x-files": [
    "perspectives.jsonl"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "at",
    "by",
    "id",
    "name",
    "applies",
    "why",
    "from"
  ],
  "properties": {
    "type": {
      "const": "perspective"
    },
    "at": {
      "$ref": "base.schema.json#/$defs/at"
    },
    "by": {
      "$ref": "base.schema.json#/$defs/by"
    },
    "id": {
      "$ref": "base.schema.json#/$defs/id",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "applies": {
      "type": "boolean"
    },
    "why": {
      "type": "string",
      "minLength": 1
    },
    "from": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "built_in",
            "standard"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "built_in"
              }
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "built_in"
              },
              "method": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "standard"
              }
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "file"
            ],
            "properties": {
              "type": {
                "const": "standard"
              },
              "file": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
