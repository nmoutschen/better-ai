{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "log.schema.json",
  "title": "one line of logs/<agent>.jsonl: an agent's start, step, question, block or hand-back",
  "$comment": "Only that agent writes it. The type and the result are checked against the role in the agent's card, logs/<agent>.card.json: a verifier does not ask or block.",
  "x-files": [
    "logs/*.jsonl"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "at",
    "by",
    "text"
  ],
  "properties": {
    "type": {
      "enum": [
        "start",
        "step",
        "asked",
        "blocked",
        "handed_back"
      ],
      "x-mode-sets": {
        "file": "{stem}.card.json",
        "field": "role",
        "builder": [
          "start",
          "step",
          "asked",
          "blocked",
          "handed_back"
        ],
        "verifier": [
          "start",
          "step",
          "handed_back"
        ]
      }
    },
    "at": {
      "$ref": "base.schema.json#/$defs/at"
    },
    "by": {
      "$ref": "base.schema.json#/$defs/by"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "enum": [
        "done",
        "partly done",
        "blocked",
        "passes",
        "fails"
      ],
      "x-mode-sets": {
        "file": "{stem}.card.json",
        "field": "role",
        "builder": [
          "done",
          "partly done",
          "blocked"
        ],
        "verifier": [
          "passes",
          "fails"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "handed_back"
          }
        }
      },
      "then": {
        "required": [
          "result"
        ]
      }
    },
    {
      "if": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "start",
              "step",
              "asked",
              "blocked"
            ]
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "result"
              ]
            }
          ]
        }
      }
    }
  ]
}
