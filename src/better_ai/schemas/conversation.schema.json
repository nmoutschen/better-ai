{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conversation.schema.json",
  "title": "one line of conversation.jsonl, the events every page shares: the user's comments and notes, and the agent's replies and states",
  "$comment": "Shared by every page skill. A page's own events, and its comment anchor, are in its <page>-events.schema.json, which a line must meet too. A line that reuses an item's id is a new version of that item; the latest wins.",
  "x-files": ["conversation.jsonl"],
  "x-versioned": true,
  "type": "object",
  "required": ["type", "at", "by"],
  "properties": {
    "type": {"type": "string", "minLength": 1},
    "at": {"$ref": "base.schema.json#/$defs/at"},
    "by": {"$ref": "base.schema.json#/$defs/by"}
  },
  "allOf": [
    {"if": {"required": ["type"], "properties": {"type": {"const": "comment"}}}, "then": {"$ref": "#/$defs/comment"}},
    {"if": {"required": ["type"], "properties": {"type": {"const": "note"}}}, "then": {"$ref": "#/$defs/note"}},
    {"if": {"required": ["type"], "properties": {"type": {"const": "reply"}}}, "then": {"$ref": "#/$defs/reply"}},
    {"if": {"required": ["type"], "properties": {"type": {"const": "status"}}}, "then": {"$ref": "#/$defs/status"}},
    {"if": {"required": ["type"], "properties": {"type": {"const": "accept"}}}, "then": {"$ref": "#/$defs/accept"}},
    {"if": {"required": ["type"], "properties": {"type": {"const": "accepted"}}}, "then": {"$ref": "#/$defs/accepted"}},
    {"if": {"required": ["type"], "properties": {"type": {"const": "delete"}}}, "then": {"$ref": "#/$defs/delete"}},
    {"if": {"required": ["type"], "properties": {"type": {"const": "reopen"}}}, "then": {"$ref": "#/$defs/reopen"}},
    {"if": {"required": ["type"], "properties": {"type": {"const": "answer"}}}, "then": {"$ref": "#/$defs/answer"}}
  ],
  "$defs": {
    "user": {"const": "user"},
    "agent": {"type": "string", "minLength": 1, "not": {"const": "user"}},
    "id": {"$ref": "base.schema.json#/$defs/id"},
    "to": {"type": "string", "minLength": 1},
    "words": {"type": "string", "minLength": 1},
    "comment": {
      "description": "the user's comment on a part of the page; the page's own schema says what `on` holds, and design-better's text is null only with a verdict",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "at", "by", "id", "text", "on"],
      "properties": {
        "type": {"const": "comment"},
        "at": {"$ref": "base.schema.json#/$defs/at"},
        "by": {"$ref": "#/$defs/user"},
        "id": {"$ref": "#/$defs/id"},
        "n": {"type": "integer"},
        "text": {"type": ["string", "null"]},
        "on": {"type": "object"},
        "verdict": {"enum": ["up", "down"]}
      }
    },
    "note": {
      "description": "the user's message; `to` is the item it answers, or null for a message of its own; `on` is what the page adds, and the page's own schema says whether it may",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "at", "by", "id", "text", "to"],
      "properties": {
        "type": {"const": "note"},
        "at": {"$ref": "base.schema.json#/$defs/at"},
        "by": {"$ref": "#/$defs/user"},
        "id": {"$ref": "#/$defs/id"},
        "text": {"$ref": "#/$defs/words"},
        "to": {"type": ["string", "null"]},
        "on": {"type": "object"}
      }
    },
    "reply": {
      "description": "the agent's reply; `to` is the item it answers, or null for a question of its own",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "at", "by", "id", "text", "to"],
      "properties": {
        "type": {"const": "reply"},
        "at": {"$ref": "base.schema.json#/$defs/at"},
        "by": {"$ref": "#/$defs/agent"},
        "id": {"$ref": "#/$defs/id"},
        "text": {"$ref": "#/$defs/words"},
        "to": {"type": ["string", "null"]}
      }
    },
    "status": {
      "description": "where the agent is with one of the threads",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "at", "by", "to", "status"],
      "properties": {
        "type": {"const": "status"},
        "at": {"$ref": "base.schema.json#/$defs/at"},
        "by": {"$ref": "#/$defs/agent"},
        "to": {"$ref": "#/$defs/to"},
        "status": {"enum": ["seen", "asked", "working", "done"]},
        "read": {"description": "the log line (from 0) of the last event the agent read before it wrote this status, which it passes as --read: the number `pending` or the turn's prompt printed last; a status whose read is before the user's latest event in the thread changes nothing, and one without read (logs before it) counts, a done one as closed by the user", "type": "integer", "minimum": 0}
      }
    },
    "accept": {
      "description": "the user's Accept button",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "at", "by", "to"],
      "properties": {
        "type": {"const": "accept"},
        "at": {"$ref": "base.schema.json#/$defs/at"},
        "by": {"$ref": "#/$defs/user"},
        "to": {"$ref": "#/$defs/to"}
      }
    },
    "accepted": {
      "description": "the agent's record of an acceptance the user gave in the chat, with the user's words",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "at", "by", "to", "text"],
      "properties": {
        "type": {"const": "accepted"},
        "at": {"$ref": "base.schema.json#/$defs/at"},
        "by": {"$ref": "#/$defs/agent"},
        "to": {"$ref": "#/$defs/to"},
        "text": {"$ref": "#/$defs/words"}
      }
    },
    "delete": {
      "description": "the user took a comment back",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "at", "by", "to"],
      "properties": {
        "type": {"const": "delete"},
        "at": {"$ref": "base.schema.json#/$defs/at"},
        "by": {"$ref": "#/$defs/user"},
        "to": {"$ref": "#/$defs/to"}
      }
    },
    "answer": {
      "description": "the user's answer to a decision; default when they took the proposed one",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "at", "by", "id", "decision", "text", "default"],
      "properties": {
        "type": {"const": "answer"},
        "at": {"$ref": "base.schema.json#/$defs/at"},
        "by": {"$ref": "#/$defs/user"},
        "id": {"$ref": "#/$defs/id"},
        "decision": {"type": "string", "minLength": 1},
        "text": {"$ref": "#/$defs/words"},
        "default": {"type": "boolean"}
      }
    },
    "reopen": {
      "description": "the user put a finished item back with the agent, with why in their words",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "at", "by", "to", "text"],
      "properties": {
        "type": {"const": "reopen"},
        "at": {"$ref": "base.schema.json#/$defs/at"},
        "by": {"$ref": "#/$defs/user"},
        "to": {"$ref": "#/$defs/to"},
        "text": {"$ref": "#/$defs/words"}
      }
    }
  }
}
