{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dashboard-events.schema.json",
  "title": "what the coordinator dashboard adds to conversation.jsonl: its own events, and what a comment's `on` holds",
  "$comment": "A line must meet this schema and conversation.schema.json. `type` lists every event this page's log may hold; the page's own events are described here in full.",
  "x-files": ["conversation.jsonl"],
  "x-versioned": true,
  "type": "object",
  "properties": {
    "type": {"enum": ["comment", "note", "answer", "accept", "reopen", "reply", "status", "accepted"]}
  },
  "allOf": [
    {
      "if": {"required": ["type"], "properties": {"type": {"const": "comment"}}},
      "then": {
        "required": ["on"],
        "properties": {
          "on": {"$ref": "#/$defs/on"},
          "text": {"type": "string", "minLength": 1}
        },
        "not": {"required": ["verdict"]}
      }
    },
    {
      "if": {"required": ["type"], "properties": {"type": {"const": "note"}}},
      "then": {"not": {"required": ["on"]}}
    }
  ],
  "$defs": {
    "on": {
      "description": "what a comment is on: a kind of thing on the page, its id and its title",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "title"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string"}
      }
    }
  }
}
