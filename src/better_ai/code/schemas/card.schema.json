{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "card.schema.json",
  "title": "logs/<agent>.card.json: what an agent works on, written by the coordinator before it starts the agent",
  "$comment": "The agent's mode is its task's: the dashboard reads it from tasks.jsonl.",
  "x-files": [
    "logs/*.card.json"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "at",
    "by",
    "role",
    "task",
    "branch"
  ],
  "properties": {
    "type": {
      "const": "card"
    },
    "at": {
      "$ref": "base.schema.json#/$defs/at"
    },
    "by": {
      "$ref": "base.schema.json#/$defs/by"
    },
    "role": {
      "enum": [
        "builder",
        "verifier"
      ]
    },
    "task": {
      "type": "string",
      "pattern": "^T\\d+$",
      "x-points-to": {
        "file": "../tasks.jsonl",
        "type": "task"
      }
    },
    "branch": {
      "type": "string",
      "minLength": 1
    }
  }
}
