{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "instructions.schema.json",
  "title": "one line of instructions.jsonl: an instruction on how to work, with the user's words",
  "$comment": "Only how-to-work instructions: a constraint on what the code does goes into the spec.",
  "x-files": [
    "instructions.jsonl"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "at",
    "by",
    "instruction",
    "said"
  ],
  "properties": {
    "type": {
      "const": "instruction"
    },
    "at": {
      "$ref": "base.schema.json#/$defs/at"
    },
    "by": {
      "$ref": "base.schema.json#/$defs/by"
    },
    "instruction": {
      "type": "string",
      "minLength": 1
    },
    "said": {
      "type": "string",
      "minLength": 1
    }
  }
}
