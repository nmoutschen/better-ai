{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "questions.schema.json",
  "title": "one question of the research plan, one file per question; its claims are the claims whose `question` names it",
  "x-files": ["questions/*.json"],
  "x-id-from-filename": true,
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "at", "by", "id", "question", "title", "priority", "status", "origin", "kind", "stakes", "done_when", "note"],
  "properties": {
    "type": {"const": "question"},
    "at": {"$ref": "base.schema.json#/$defs/at"},
    "by": {"$ref": "base.schema.json#/$defs/by"},
    "id": {"type": "string", "pattern": "^Q-[\\w.-]+-\\d+$", "x-id": {"prefix": "Q", "agent": true}},
    "question": {"type": "string", "minLength": 1},
    "title": {"description": "the question in at most six plain words", "type": "string", "minLength": 1},
    "priority": {"enum": ["high", "medium", "low"]},
    "status": {"enum": ["proposed", "open", "in progress", "answered", "contested", "not found", "unclear", "out of scope", "merged"]},
    "owner": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "gist": {"description": "the answer in one plain sentence", "type": "string", "minLength": 1},
    "merged_into": {"type": "string", "x-differs-from": "id", "x-points-to": {"file": "../questions/", "type": "question"}},
    "origin": {
      "anyOf": [
        {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"const": "user"}}},
        {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"const": "meaning"}}},
        {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"const": "goal"}}},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "question"],
          "properties": {
            "type": {"const": "question"},
            "question": {"type": "string", "x-points-to": {"file": "../questions/", "type": "question"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "source"],
          "properties": {
            "type": {"const": "source"},
            "source": {"type": "string", "x-points-to": {"file": "../sources/", "type": "source"}}
          }
        }
      ]
    },
    "kind": {"enum": ["seed", "frontier", "challenge", "chain", "conflict", "gap"]},
    "raised_in": {"type": "string", "x-points-to": {"file": "../questions/", "type": "question"}},
    "lens": {"type": "string", "minLength": 1},
    "stakes": {"type": "string", "minLength": 1},
    "done_when": {"type": "string", "minLength": 1},
    "note": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"required": ["status"], "properties": {"status": {"enum": ["in progress", "answered", "contested", "not found", "unclear"]}}},
      "then": {"required": ["owner"]},
      "else": {"not": {"required": ["owner"]}}
    },
    {
      "if": {"required": ["status"], "properties": {"status": {"enum": ["answered", "contested", "not found", "unclear"]}}},
      "then": {"required": ["summary", "gist"]},
      "else": {"not": {"anyOf": [{"required": ["summary"]}, {"required": ["gist"]}]}}
    },
    {
      "if": {"required": ["status"], "properties": {"status": {"const": "merged"}}},
      "then": {"required": ["merged_into"], "x-check": "merge-loop"},
      "else": {"not": {"required": ["merged_into"]}}
    },
    {
      "if": {"required": ["kind"], "properties": {"kind": {"enum": ["frontier", "chain", "conflict", "gap"]}}},
      "then": {"required": ["raised_in"]},
      "else": {"not": {"required": ["raised_in"]}}
    },
    {
      "if": {"required": ["kind"], "properties": {"kind": {"const": "frontier"}}},
      "then": {"required": ["lens"]},
      "else": {"not": {"required": ["lens"]}}
    }
  ]
}
