{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spec.schema.json",
  "title": "a show-better presentation spec: .show/<slug>/spec.json",
  "$comment": "The shape of the spec: types, required fields, allowed values, and what its parts say about each other, which the show_spec hook (show/checks.py) checks: the node an edge names, the set a region names, a lane step's actor, the cells of a matrix or table row, a tree's sums, a map's sections, an action's panel, the overview and the focus. the deck module keeps what only the drawing knows (a tree's depth, the number of units, a negative bar, an svg's elements), the readability warnings and the digest. A spec is a document a renderer draws, so it has `type`, `at` and `by`, and no `id`. A spec written before `at` and `by` were required meets `old_spec` and is kept as is.",
  "x-files": ["spec.json"],
  "x-check": "show_spec",
  "type": "object",
  "required": ["type", "at", "by", "title", "panels"],
  "allOf": [{"$ref": "#/$defs/spec_fields"}],
  "properties": {
    "type": {"const": "slides"},
    "at": {"$ref": "base.schema.json#/$defs/at"},
    "by": {"$ref": "base.schema.json#/$defs/by"}
  },
  "x-old-format": [{"$ref": "#/$defs/old_spec"}],
  "$defs": {
    "spec_fields": {
      "description": "the fields of a spec besides type, at and by",
      "type": "object",
      "properties": {
        "title": {"$ref": "#/$defs/text"},
        "question": {"type": ["string", "null"]},
        "summary": {"type": ["string", "null"]},
        "source": {"type": ["string", "null"]},
        "lang": {"type": ["string", "null"]},
        "document": {"$ref": "#/$defs/document"},
        "style": {"$ref": "#/$defs/style"},
        "panels": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/panel"}}
      }
    },
    "old_spec": {
      "description": "a spec from before `at` and `by` were required, or before `type` existed: kept as is, not converted",
      "type": "object",
      "required": ["title", "panels"],
      "allOf": [{"$ref": "#/$defs/spec_fields"}],
      "properties": {
        "type": {"const": "slides"},
        "at": {"anyOf": [{"$ref": "base.schema.json#/$defs/at"}, {"type": "null"}]},
        "by": {"anyOf": [{"$ref": "base.schema.json#/$defs/by"}, {"type": "null"}]}
      }
    },
    "text": {"type": "string", "minLength": 1},
    "detail": {
      "description": "what opens under a visual when its label or mark is clicked",
      "type": ["object", "null"],
      "required": ["text"],
      "properties": {
        "text": {"$ref": "#/$defs/text"},
        "source": {"type": ["string", "null"]},
        "evidence": {"enum": ["strong", "moderate", "weak", "stated", null]}
      }
    },
    "source": {
      "description": "what the slide's claim rests on: a sentence, or a sentence with the section of the document to read",
      "anyOf": [
        {"type": "string"},
        {"type": "null"},
        {
          "type": "object",
          "anyOf": [
            {"required": ["text"], "properties": {"text": {"$ref": "#/$defs/text"}}},
            {"required": ["section"], "properties": {"section": {"$ref": "#/$defs/text"}}}
          ]
        }
      ]
    },
    "document": {
      "type": ["object", "null"],
      "description": "the document the slides introduce",
      "required": ["title"],
      "properties": {
        "title": {"$ref": "#/$defs/text"},
        "address": {"type": ["string", "null"], "pattern": "^https?://\\S+$"},
        "sections": {
          "type": ["array", "null"],
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": {"type": ["string", "number"], "minLength": 1},
              "label": {"$ref": "#/$defs/text"},
              "gist": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "style": {
      "description": "the project's look for the slides and their drawings: CSS colours and font stacks",
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "background": {
          "type": ["string", "null"],
          "pattern": "^\\s*(?:#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\([0-9.,%\\s/]+\\))\\s*$"
        },
        "tint": {
          "type": ["string", "null"],
          "pattern": "^\\s*(?:#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\([0-9.,%\\s/]+\\))\\s*$"
        },
        "ink": {
          "type": ["string", "null"],
          "pattern": "^\\s*(?:#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\([0-9.,%\\s/]+\\))\\s*$"
        },
        "heading": {
          "type": ["string", "null"],
          "pattern": "^\\s*(?:#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\([0-9.,%\\s/]+\\))\\s*$"
        },
        "muted": {
          "type": ["string", "null"],
          "pattern": "^\\s*(?:#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\([0-9.,%\\s/]+\\))\\s*$"
        },
        "line": {
          "type": ["string", "null"],
          "pattern": "^\\s*(?:#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\([0-9.,%\\s/]+\\))\\s*$"
        },
        "point": {
          "type": ["string", "null"],
          "pattern": "^\\s*(?:#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\([0-9.,%\\s/]+\\))\\s*$"
        },
        "serif": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9 ,'\\\"-]+$"},
        "sans": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9 ,'\\\"-]+$"}
      }
    },
    "kind": {
      "description": "the kinds of a visual; a side of a compare takes the same",
      "enum": [
        "map",
        "concept",
        "flow",
        "groups",
        "tree",
        "sets",
        "matrix",
        "effects",
        "pairs",
        "quadrant",
        "numbers",
        "units",
        "bars",
        "slope",
        "dots",
        "scatter",
        "line",
        "timeline",
        "table",
        "text",
        "svg",
        "lanes",
        "fork"
      ]
    },
    "visual": {
      "description": "one visual: a kind and that kind's fields",
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"$ref": "#/$defs/kind"}
      },
      "allOf": [
        {"if": {"required": ["kind"], "properties": {"kind": {"const": "map"}}}, "then": {"$ref": "#/$defs/kind_map"}},
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "concept"}}},
          "then": {"$ref": "#/$defs/kind_concept"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "flow"}}},
          "then": {"$ref": "#/$defs/kind_flow"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "groups"}}},
          "then": {"$ref": "#/$defs/kind_groups"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "tree"}}},
          "then": {"$ref": "#/$defs/kind_tree"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "sets"}}},
          "then": {"$ref": "#/$defs/kind_sets"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "matrix"}}},
          "then": {"$ref": "#/$defs/kind_matrix"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "effects"}}},
          "then": {"$ref": "#/$defs/kind_effects"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "pairs"}}},
          "then": {"$ref": "#/$defs/kind_pairs"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "quadrant"}}},
          "then": {"$ref": "#/$defs/kind_quadrant"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "numbers"}}},
          "then": {"$ref": "#/$defs/kind_numbers"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "units"}}},
          "then": {"$ref": "#/$defs/kind_units"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "bars"}}},
          "then": {"$ref": "#/$defs/kind_bars"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "slope"}}},
          "then": {"$ref": "#/$defs/kind_slope"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "dots"}}},
          "then": {"$ref": "#/$defs/kind_dots"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "scatter"}}},
          "then": {"$ref": "#/$defs/kind_scatter"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "line"}}},
          "then": {"$ref": "#/$defs/kind_line"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "timeline"}}},
          "then": {"$ref": "#/$defs/kind_timeline"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "table"}}},
          "then": {"$ref": "#/$defs/kind_table"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "text"}}},
          "then": {"$ref": "#/$defs/kind_text"}
        },
        {"if": {"required": ["kind"], "properties": {"kind": {"const": "svg"}}}, "then": {"$ref": "#/$defs/kind_svg"}},
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "lanes"}}},
          "then": {"$ref": "#/$defs/kind_lanes"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "fork"}}},
          "then": {"$ref": "#/$defs/kind_fork"}
        }
      ]
    },
    "side": {
      "description": "one side of a compare panel: a label, and a visual",
      "type": "object",
      "required": ["label", "kind"],
      "properties": {
        "label": {"$ref": "#/$defs/text"},
        "kind": {"$ref": "#/$defs/kind"},
        "detail": {"$ref": "#/$defs/detail"}
      },
      "allOf": [
        {"if": {"required": ["kind"], "properties": {"kind": {"const": "map"}}}, "then": {"$ref": "#/$defs/kind_map"}},
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "concept"}}},
          "then": {"$ref": "#/$defs/kind_concept"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "flow"}}},
          "then": {"$ref": "#/$defs/kind_flow"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "groups"}}},
          "then": {"$ref": "#/$defs/kind_groups"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "tree"}}},
          "then": {"$ref": "#/$defs/kind_tree"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "sets"}}},
          "then": {"$ref": "#/$defs/kind_sets"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "matrix"}}},
          "then": {"$ref": "#/$defs/kind_matrix"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "effects"}}},
          "then": {"$ref": "#/$defs/kind_effects"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "pairs"}}},
          "then": {"$ref": "#/$defs/kind_pairs"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "quadrant"}}},
          "then": {"$ref": "#/$defs/kind_quadrant"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "numbers"}}},
          "then": {"$ref": "#/$defs/kind_numbers"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "units"}}},
          "then": {"$ref": "#/$defs/kind_units"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "bars"}}},
          "then": {"$ref": "#/$defs/kind_bars"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "slope"}}},
          "then": {"$ref": "#/$defs/kind_slope"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "dots"}}},
          "then": {"$ref": "#/$defs/kind_dots"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "scatter"}}},
          "then": {"$ref": "#/$defs/kind_scatter"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "line"}}},
          "then": {"$ref": "#/$defs/kind_line"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "timeline"}}},
          "then": {"$ref": "#/$defs/kind_timeline"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "table"}}},
          "then": {"$ref": "#/$defs/kind_table"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "text"}}},
          "then": {"$ref": "#/$defs/kind_text"}
        },
        {"if": {"required": ["kind"], "properties": {"kind": {"const": "svg"}}}, "then": {"$ref": "#/$defs/kind_svg"}},
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "lanes"}}},
          "then": {"$ref": "#/$defs/kind_lanes"}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "fork"}}},
          "then": {"$ref": "#/$defs/kind_fork"}
        }
      ]
    },
    "compare": {
      "type": "object",
      "required": ["a", "b"],
      "properties": {"a": {"$ref": "#/$defs/side"}, "b": {"$ref": "#/$defs/side"}}
    },
    "statement": {
      "type": "object",
      "required": ["figure", "sentence"],
      "properties": {
        "figure": {"$ref": "#/$defs/text"},
        "sentence": {"$ref": "#/$defs/text"},
        "compare": {"type": ["string", "null"]}
      }
    },
    "title": {
      "type": "object",
      "properties": {
        "body": {"type": ["string", "null"]},
        "actions": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "required": ["text", "panel"],
            "properties": {"text": {"$ref": "#/$defs/text"}, "panel": {"type": "integer"}}
          }
        }
      }
    },
    "panel": {
      "type": "object",
      "required": ["headline"],
      "properties": {
        "template": {"enum": ["visual", "compare", "statement", "title", null]},
        "part": {"type": ["string", "null"]},
        "headline": {"type": "string", "pattern": "\\S"},
        "source": {"$ref": "#/$defs/source"},
        "overview": {"type": ["boolean", "null"]},
        "focus": {"type": ["string", "array", "null"], "items": {"type": "string"}}
      },
      "allOf": [
        {
          "if": {"required": ["template"], "properties": {"template": {"const": "compare"}}},
          "then": {"$ref": "#/$defs/compare"}
        },
        {
          "if": {"required": ["template"], "properties": {"template": {"const": "statement"}}},
          "then": {"$ref": "#/$defs/statement"}
        },
        {
          "if": {"required": ["template"], "properties": {"template": {"const": "title"}}},
          "then": {"$ref": "#/$defs/title"}
        },
        {"if": {"not": {"required": ["template"]}}, "then": {"$ref": "#/$defs/visual"}},
        {
          "if": {"required": ["template"], "properties": {"template": {"const": null}}},
          "then": {"$ref": "#/$defs/visual"}
        },
        {
          "if": {"required": ["template"], "properties": {"template": {"const": "visual"}}},
          "then": {"$ref": "#/$defs/visual"}
        },
        {
          "if": {"required": ["overview"], "properties": {"overview": {"const": true}}},
          "then": {
            "required": ["kind"],
            "properties": {"template": {"enum": ["visual"]}, "kind": {"enum": ["flow", "timeline", "concept", "groups"]}}
          }
        }
      ]
    },
    "childnode": {
      "description": "a part of the tree: a leaf has its value, a node with children may take the sum of them",
      "allOf": [{"$ref": "#/$defs/treenode"}],
      "if": {"not": {"required": ["children"], "properties": {"children": {"type": "array", "minItems": 1}}}},
      "then": {"required": ["value"], "properties": {"value": {"type": "number"}}}
    },
    "treenode": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": {"$ref": "#/$defs/text"},
        "value": {"type": ["number", "null"]},
        "children": {"type": ["array", "null"], "items": {"$ref": "#/$defs/childnode"}},
        "detail": {"$ref": "#/$defs/detail"}
      }
    },
    "kind_map": {
      "type": "object",
      "properties": {
        "sections": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "required": ["label"],
            "properties": {
              "id": {"type": ["string", "number", "null"], "minLength": 1},
              "label": {"$ref": "#/$defs/text"},
              "gist": {"type": ["string", "null"]},
              "detail": {"$ref": "#/$defs/detail"}
            }
          }
        },
        "highlight": {"type": ["array", "string", "null"], "items": {"type": ["string", "number"]}}
      }
    },
    "kind_concept": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {"id": {"$ref": "#/$defs/text"}, "label": {"$ref": "#/$defs/text"}, "detail": {"$ref": "#/$defs/detail"}}
          }
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["from", "to", "label"],
            "properties": {
              "from": {"$ref": "#/$defs/text"},
              "to": {"$ref": "#/$defs/text"},
              "label": {"$ref": "#/$defs/text"},
              "detail": {"$ref": "#/$defs/detail"}
            }
          }
        }
      }
    },
    "kind_flow": {
      "type": "object",
      "required": ["arrow", "steps"],
      "properties": {
        "arrow": {"$ref": "#/$defs/text"},
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["label"],
            "properties": {
              "label": {"$ref": "#/$defs/text"},
              "note": {"type": ["string", "null"]},
              "detail": {"$ref": "#/$defs/detail"}
            }
          }
        }
      }
    },
    "kind_groups": {
      "type": "object",
      "required": ["groups"],
      "properties": {
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["label"],
            "properties": {"label": {"type": "string"}, "items": {"type": ["array", "null"]}, "detail": {"$ref": "#/$defs/detail"}}
          }
        }
      }
    },
    "kind_tree": {
      "type": "object",
      "required": ["root"],
      "properties": {"unit": {"type": ["string", "null"]}, "root": {"$ref": "#/$defs/treenode"}}
    },
    "kind_sets": {
      "type": "object",
      "required": ["sets", "regions"],
      "properties": {
        "sets": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["in"],
            "properties": {
              "in": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "label": {"type": ["string", "null"]},
              "count": {"type": ["number", "null"]},
              "detail": {"$ref": "#/$defs/detail"}
            },
            "anyOf": [
              {"required": ["label"], "properties": {"label": {"$ref": "#/$defs/text"}}},
              {"required": ["count"], "properties": {"count": {"type": "number"}}}
            ]
          }
        }
      }
    },
    "kind_matrix": {
      "type": "object",
      "required": ["columns", "rows"],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              {"$ref": "#/$defs/text"},
              {"type": "object", "required": ["label"], "properties": {"label": {"$ref": "#/$defs/text"}}}
            ]
          }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["label", "cells"],
            "properties": {
              "label": {"$ref": "#/$defs/text"},
              "group": {"type": ["string", "null"]},
              "cells": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {"type": "null"},
                    {"enum": ["yes", "no", "up", "down", "same"]},
                    {"type": "object", "properties": {"mark": {"enum": ["yes", "no", "up", "down", "same", null]}}}
                  ]
                }
              },
              "detail": {"$ref": "#/$defs/detail"}
            }
          }
        }
      }
    },
    "kind_effects": {
      "type": "object",
      "required": ["rows"],
      "properties": {
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["label", "effect"],
            "properties": {
              "label": {"$ref": "#/$defs/text"},
              "effect": {"enum": ["up", "down", "same"]},
              "group": {"type": ["string", "null"]},
              "outcome": {"type": ["string", "null"]},
              "detail": {"$ref": "#/$defs/detail"}
            }
          }
        }
      }
    },
    "kind_pairs": {
      "type": "object",
      "required": ["columns", "rows"],
      "properties": {
        "columns": {"type": "array", "minItems": 2, "items": {"type": "string"}, "maxItems": 2},
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["label"],
            "properties": {
              "label": {"$ref": "#/$defs/text"},
              "left": {
                "type": ["array", "null"],
                "items": {
                  "type": "object",
                  "required": ["label"],
                  "properties": {
                    "label": {"$ref": "#/$defs/text"},
                    "effect": {"enum": ["up", "down", "same", null]},
                    "detail": {"$ref": "#/$defs/detail"}
                  }
                }
              },
              "right": {
                "type": ["array", "null"],
                "items": {
                  "type": "object",
                  "required": ["label"],
                  "properties": {
                    "label": {"$ref": "#/$defs/text"},
