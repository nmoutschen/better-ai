{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "architect.schema.json",
  "title": "architect.json: the metadata of one design run",
  "$comment": "The request word for word, and what the page shows about the run. design.json holds only the diagrams.",
  "x-files": [
    "architect.json"
  ],
  "x-required-files": [
    "architect.json",
    "design.json"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "at",
    "by",
    "request",
    "title",
    "summary",
    "scope",
    "accepted"
  ],
  "properties": {
    "type": {
      "const": "architect"
    },
    "at": {
      "$ref": "base.schema.json#/$defs/at"
    },
    "by": {
      "$ref": "base.schema.json#/$defs/by"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "from"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "chat",
                "issue",
                "file"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "chat"
                  }
                }
              },
              "then": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "chat"
                  }
                }
              }
            },
            {
              "if": {
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "issue"
                  }
                }
              },
              "then": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "url"
                ],
                "properties": {
                  "type": {
                    "const": "issue"
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            {
              "if": {
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "file"
                  }
                }
              },
              "then": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "path"
                ],
                "properties": {
                  "type": {
                    "const": "file"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          ]
        }
      }
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "accepted": {
      "type": "array",
      "items": {
        "enum": [
          "requirements",
          "containers",
          "flows",
          "perspectives",
          "decisions",
          "spec"
        ]
      }
    },
    "document": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        }
      },
      "x-check": "source-file-exists"
    }
  }
}
