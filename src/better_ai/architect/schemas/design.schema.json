{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design.schema.json",
  "title": "design.json: the containers and flows the page draws",
  "$comment": "Only the diagrams. Every flow has an id, so a part key never depends on a flow's position. A flow is a sequence flow (participants and steps) or, with kind `logic`, a logic flow (nodes and edges: a process with decisions, loops back and exits, or a lifecycle of states); the renderer finds the loops back. A group has a kind: `boundary` (the default), `trust` or `runs` (where boxes run), and `within` nests it in a group of its kind. The design-references hook of the architect package checks what the shape cannot: that an edge, a group, a participant, a step, a node or a `by` names what exists, that an id is used once, that a box kind is in the register (kinds.json), that `in` names only `before`, `after` or an alternative, that a box is in one group per kind, and that a logic flow has one start, decisions with two labelled outcomes and no node that cannot be reached or cannot reach an exit.",
  "x-files": [
    "design.json"
  ],
  "x-required-files": [
    "architect.json",
    "design.json"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "at",
    "by",
    "containers",
    "flows"
  ],
  "properties": {
    "type": {
      "const": "design"
    },
    "at": {
      "$ref": "base.schema.json#/$defs/at"
    },
    "by": {
      "$ref": "base.schema.json#/$defs/by"
    },
    "containers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[^\\s:+/]+$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "detail": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "in": {
                "$ref": "#/$defs/in"
              }
            }
          }
        },
        "edges": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "from",
              "to"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[^\\s:+/]+$"
              },
              "from": {
                "type": "string",
                "pattern": "^[^\\s:+/]+$"
              },
              "to": {
                "type": "string",
                "pattern": "^[^\\s:+/]+$"
              },
              "label": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "in": {
                "$ref": "#/$defs/in"
              }
            }
          }
        },
        "groups": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "members"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[^\\s:+/]+$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "members": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[^\\s:+/]+$"
                }
              },
              "in": {
                "$ref": "#/$defs/in"
              },
              "kind": {
                "description": "what the group shows: `boundary` (a system boundary, the default), `trust` (a trust boundary) or `runs` (where its boxes run, such as a region, a zone or a host)",
                "enum": [
                  "boundary",
                  "trust",
                  "runs",
                  null
                ]
              },
              "within": {
                "description": "the id of the group of the same kind this group sits inside",
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[^\\s:+/]+$"
              }
            }
          }
        }
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[^\\s:+/]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "in": {
            "$ref": "#/$defs/in"
          },
          "participants": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "box"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[^\\s:+/]+$"
                },
                "box": {
                  "type": "string",
                  "pattern": "^[^\\s:+/]+$"
                },
                "in": {
                  "$ref": "#/$defs/in"
                }
              }
            }
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "from",
                "to"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[^\\s:+/]+$"
                },
                "from": {
                  "type": "string",
                  "pattern": "^[^\\s:+/]+$"
                },
                "to": {
                  "type": "string",
                  "pattern": "^[^\\s:+/]+$"
                },
                "label": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "kind": {
                  "enum": [
                    "request",
                    "response",
                    "async",
                    null
                  ]
                },
                "in": {
                  "$ref": "#/$defs/in"
                }
              }
            }
          },
          "kind": {
            "description": "`sequence` (the default): participants and steps; `logic`: nodes and edges",
            "enum": [
              "sequence",
              "logic",
              null
            ]
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "type"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[^\\s:+/]+$"
                },
                "type": {
                  "enum": [
                    "start",
                    "step",
                    "decision",
                    "state",
                    "exit"
                  ]
                },
                "label": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "by": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[^\\s:+/]+$",
                  "description": "the id of the container box that does the step"
                },
                "outcome": {
                  "description": "how an exit ends the flow",
                  "enum": [
                    "positive",
                    "negative",
                    null
                  ]
                },
                "in": {
                  "$ref": "#/$defs/in"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "exit"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "label",
                      "outcome"
                    ],
                    "properties": {
                      "label": {
                        "type": "string"
                      },
                      "outcome": {
                        "enum": [
                          "positive",
                          "negative"
                        ]
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "enum": [
                          "step",
                          "decision",
                          "state"
                        ]
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "label"
                    ],
                    "properties": {
                      "label": {
                        "type": "string"
                      }
                    }
                  }
                }
              ]
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "from",
                "to"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[^\\s:+/]+$"
                },
                "from": {
                  "type": "string",
                  "pattern": "^[^\\s:+/]+$"
                },
                "to": {
                  "type": "string",
                  "pattern": "^[^\\s:+/]+$"
                },
                "label": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "in": {
                  "$ref": "#/$defs/in"
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "logic"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "nodes",
                "edges"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "participants"
                    ]
                  },
                  {
                    "required": [
                      "steps"
                    ]
                  }
                ]
              }
            },
            "else": {
              "required": [
                "participants",
                "steps"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "nodes"
                    ]
                  },
                  {
                    "required": [
                      "edges"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "alternatives": {
      "description": "the designs still in the running, each a version after the change that `in` can name; absent once one is chosen",
      "type": [
        "array",
        "null"
      ],
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "summary",
          "strengths",
          "drawbacks"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/version"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "strengths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "drawbacks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "x-check": "design-flow-ids"
    },
    {
      "x-check": "design-references"
    },
    {
      "x-check": "design-renders"
    }
  ],
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[a-z0-9]+$"
    },
    "in": {
      "description": "the versions a part exists in, each one word of lowercase letters and digits, so no element id of the drawing can be read two ways: `before`, `after` (every version after the change), or the id of an alternative; absent for a part in all",
      "type": [
        "array",
        "null"
      ],
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/version"
      }
    }
  }
}
