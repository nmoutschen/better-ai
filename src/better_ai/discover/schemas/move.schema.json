{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "move.schema.json",
  "title": "one line of moves.jsonl: the move the user chose, and the answer that proves it",
  "$comment": "Append only: a move is never edited. Its move is the move of its option. A move made in the chat names the answered decision that confirms it (`confirm`) when it is Expand, Adopt or Stop.",
  "x-files": ["moves.jsonl"],
  "x-check": "move-rules",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "at", "by", "id", "option", "step", "why", "answer"],
  "properties": {
    "type": {"const": "move"},
    "at": {"$ref": "base.schema.json#/$defs/at"},
    "by": {"$ref": "base.schema.json#/$defs/by"},
    "id": {"$ref": "base.schema.json#/$defs/id", "pattern": "^M\\d+$", "x-id": {"prefix": "M"}},
    "option": {"type": "string", "minLength": 1, "x-points-to": {"file": "options.jsonl", "type": "option"}},
    "step": {"description": "the step the discovery was in", "type": "string", "minLength": 1},
    "why": {"type": "string", "minLength": 1},
    "answer": {
      "type": "object",
      "required": ["type"],
      "properties": {"type": {"enum": ["page", "chat"]}},
      "allOf": [
        {
          "if": {"required": ["type"], "properties": {"type": {"const": "page"}}},
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "event"],
            "properties": {
              "type": {"const": "page"},
              "event": {"type": "string", "minLength": 1, "x-points-to": {"file": "conversation.jsonl", "type": "choose"}}
            }
          }
        },
        {
          "if": {"required": ["type"], "properties": {"type": {"const": "chat"}}},
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "text"],
            "properties": {
              "type": {"const": "chat"},
              "text": {"type": "string", "minLength": 1},
              "confirm": {"type": "string", "minLength": 1, "x-points-to": {"file": "decisions.jsonl", "type": "decision"}}
            }
          }
        }
      ]
    }
  }
}
