{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "option.schema.json",
  "title": "one line of options.jsonl: one of the seven moves, with what it costs and how hard it is to undo",
  "$comment": "The coordinator writes it; a set step stamps `updated_at`. Which option is chosen comes from the moves, never from a field here.",
  "x-files": ["options.jsonl"],
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "at", "by", "id", "move", "text", "cost", "speed", "upkeep", "undo", "note"],
  "properties": {
    "type": {"const": "option"},
    "at": {"$ref": "base.schema.json#/$defs/at"},
    "by": {"$ref": "base.schema.json#/$defs/by"},
    "id": {"$ref": "base.schema.json#/$defs/id", "pattern": "^K\\d+$", "x-id": {"prefix": "K"}},
    "move": {"enum": ["test first", "expand", "shrink", "switch", "adopt", "pause", "stop"]},
    "text": {"type": "string", "minLength": 1},
    "cost": {"type": "string", "minLength": 1},
    "speed": {"type": "string", "minLength": 1},
    "upkeep": {"type": "string", "minLength": 1},
    "undo": {"description": "how hard the move is to undo", "type": "string", "minLength": 1},
    "note": {"enum": ["proposed", "ruled out by your appetite", null]},
    "updated_at": {"$ref": "base.schema.json#/$defs/at"}
  }
}
