{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "code.schema.json",
  "title": "code.json: the goal, the design and the mode of one code-better change",
  "$comment": "The mode decides which task statuses tasks.jsonl allows (x-mode-sets there). When design is an architect folder, spec.jsonl is read from that folder (the repo-relative path in design.folder).",
  "x-files": [
    "code.json"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "at",
    "by",
    "goal",
    "design",
    "mode"
  ],
  "properties": {
    "type": {
      "const": "code"
    },
    "at": {
      "$ref": "base.schema.json#/$defs/at"
    },
    "by": {
      "$ref": "base.schema.json#/$defs/by"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "design": {
      "description": "where the design is: an architect folder (its spec.jsonl holds the spec), a file, or only the request",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "architect",
            "file",
            "request"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "architect"
              }
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "folder"
            ],
            "properties": {
              "type": {
                "const": "architect"
              },
              "folder": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "file"
              }
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "path"
            ],
            "properties": {
              "type": {
                "const": "file"
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "request"
              }
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "text"
            ],
            "properties": {
              "type": {
                "const": "request"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "mode": {
      "enum": [
        "feature",
        "bug fix",
        "refactor",
        "tests",
        "coordinate"
      ]
    }
  }
}
