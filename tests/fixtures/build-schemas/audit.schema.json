{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audit.schema.json",
  "title": "audit/<date>/audit.json: the header of one audit",
  "$comment": "The date is the folder's name.",
  "x-files": [
    "audit/*/audit.json"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "at",
    "by",
    "goal",
    "commit",
    "not_read"
  ],
  "properties": {
    "type": {
      "const": "audit"
    },
    "at": {
      "$ref": "base.schema.json#/$defs/at"
    },
    "by": {
      "$ref": "base.schema.json#/$defs/by"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "commit": {
      "type": "string",
      "minLength": 1
    },
    "not_read": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
