[
 {"name": "the agent sets the state of each item; done and accepted items are not work",
  "log": [
   {"type": "note", "id": "m1", "to": null, "text": "t", "by": "user"},
   {"type": "note", "id": "m2", "to": null, "text": "t", "by": "user"},
   {"type": "status", "to": "m2", "status": "seen", "by": "coordinator"},
   {"type": "note", "id": "m3", "to": null, "text": "t", "by": "user"},
   {"type": "status", "to": "m3", "status": "working", "by": "coordinator"},
   {"type": "note", "id": "m4", "to": null, "text": "t", "by": "user"},
   {"type": "status", "to": "m4", "status": "asked", "by": "coordinator"},
   {"type": "note", "id": "m5", "to": null, "text": "t", "by": "user"},
   {"type": "status", "to": "m5", "status": "done", "by": "coordinator"},
   {"type": "note", "id": "m6", "to": null, "text": "t", "by": "user"},
   {"type": "accept", "to": "m6", "by": "user"},
   {"type": "note", "id": "m7", "to": null, "text": "t", "by": "user"},
   {"type": "accepted", "to": "m7", "by": "coordinator", "text": "yes"}
  ],
  "work": [["m1", "new"], ["m2", "seen"], ["m3", "working"], ["m4", "asked"]]},
 {"name": "an answer to a question the agent asked ends the wait",
  "log": [
   {"type": "note", "id": "m1", "to": null, "text": "t", "by": "user"},
   {"type": "status", "to": "m1", "status": "asked", "by": "coordinator"},
   {"type": "reply", "id": "r1", "to": "m1", "text": "t", "by": "coordinator"},
   {"type": "note", "id": "m2", "to": "m1", "text": "t", "by": "user"}
  ],
  "work": [["m1", "replied"]]},
 {"name": "a reply under a done or an accepted item is a follow-up",
  "log": [
   {"type": "note", "id": "m1", "to": null, "text": "t", "by": "user"},
   {"type": "status", "to": "m1", "status": "done", "by": "coordinator"},
   {"type": "note", "id": "m2", "to": "m1", "text": "t", "by": "user"},
   {"type": "note", "id": "m3", "to": null, "text": "t", "by": "user"},
   {"type": "accept", "to": "m3", "by": "user"},
   {"type": "note", "id": "m4", "to": "m3", "text": "t", "by": "user"}
  ],
  "work": [["m1", "followup"], ["m3", "followup"]]},
 {"name": "a reply under a working item changes nothing",
  "log": [
   {"type": "note", "id": "m1", "to": null, "text": "t", "by": "user"},
   {"type": "status", "to": "m1", "status": "working", "by": "coordinator"},
   {"type": "note", "id": "m2", "to": "m1", "text": "t", "by": "user"}
  ],
  "work": [["m1", "working"]]},
 {"name": "a comment sent again keeps its state, and is the same item",
  "log": [
   {"type": "comment", "id": "c1", "n": 1, "text": "t", "by": "user"},
   {"type": "status", "to": "c1", "status": "done", "by": "coordinator"},
   {"type": "comment", "id": "c1", "n": 1, "text": "edited", "by": "user"},
   {"type": "comment", "id": "c2", "n": 2, "text": "t", "by": "user"},
   {"type": "comment", "id": "c2", "n": 2, "text": "edited", "by": "user"},
   {"type": "comment", "id": "c3", "n": 3, "text": "t", "by": "user"},
   {"type": "accept", "to": "c3", "by": "user"},
   {"type": "comment", "id": "c3", "n": 3, "text": "edited", "by": "user"}
  ],
  "work": [["c2", "new"]]},
 {"name": "a deleted comment is not work, until it is sent again",
  "log": [
   {"type": "comment", "id": "c1", "n": 1, "text": "t", "by": "user"},
   {"type": "delete", "to": "c1", "by": "user"},
   {"type": "comment", "id": "c2", "n": 2, "text": "t", "by": "user"},
   {"type": "delete", "to": "c2", "by": "user"},
   {"type": "comment", "id": "c2", "n": 2, "text": "t", "by": "user"}
  ],
  "work": [["c2", "new"]]},
 {"name": "a reopened item is work again",
  "log": [
   {"type": "comment", "id": "c1", "n": 1, "text": "t", "by": "user"},
   {"type": "status", "to": "c1", "status": "done", "by": "coordinator"},
   {"type": "reopen", "to": "c1", "text": "still wrong", "by": "user"}
  ],
  "work": [["c1", "reopened"]]},
 {"name": "a message under the agent's reply is part of the item the reply is under",
  "log": [
   {"type": "comment", "id": "c1", "n": 1, "text": "t", "by": "user"},
   {"type": "status", "to": "c1", "status": "done", "by": "coordinator"},
   {"type": "reply", "id": "r1", "to": "c1", "text": "t", "by": "coordinator"},
   {"type": "note", "id": "m1", "to": "r1", "text": "t", "by": "user"}
  ],
  "work": [["c1", "followup"]]},
 {"name": "an answer to the agent's own message is an item, and an answer under it belongs to it",
  "log": [
   {"type": "reply", "id": "r1", "to": null, "text": "t", "by": "coordinator"},
   {"type": "note", "id": "m1", "to": "r1", "text": "t", "by": "user"},
   {"type": "status", "to": "m1", "status": "asked", "by": "coordinator"},
   {"type": "note", "id": "m2", "to": "m1", "text": "t", "by": "user"},
   {"type": "note", "id": "m3", "to": "r1", "text": "t", "by": "user"}
  ],
  "work": [["m1", "replied"], ["m3", "new"]]},
 {"name": "an answer to the agent's own message that the agent asks about waits for the user, and the message's next answer is an item",
  "log": [
   {"type": "reply", "id": "r1", "to": null, "text": "t", "by": "coordinator"},
   {"type": "note", "id": "m1", "to": "r1", "text": "t", "by": "user"},
   {"type": "reply", "id": "r2", "to": "m1", "text": "t", "by": "coordinator"},
   {"type": "status", "to": "m1", "status": "asked", "by": "coordinator"},
   {"type": "note", "id": "m2", "to": "r1", "text": "t", "by": "user"}
  ],
  "work": [["m1", "asked"], ["m2", "new"]]},
 {"name": "an answer to what a worker closed is an item",
  "log": [
   {"type": "closed", "id": "x1", "by": "worker-2", "question": "Q4", "status": "answered"},
   {"type": "note", "id": "m1", "to": "x1", "text": "t", "by": "user"}
  ],
  "work": [["m1", "new"]]}
]
