#!/usr/bin/env python3
"""A stand-in for the `claude` CLI, for tests and tools/smoke.py. It never ships in a better.pyz.

It answers `--version`, and the stream-json messages the Claude Code adapter sends. STUB_MODE changes what it does:

    ok (default)   answer initialize, then every prompt with one reply
    hang           read stdin and never answer
    login          answer initialize as an account that is not logged in
    old            report a version below the minimum
    linger         keep running after stdin closes
    ask            ask for approval of a Bash command and wait for the answer before the first reply
    cancel         ask for approval of a Bash command, then cancel the request itself a second later
    verb           on the first prompt, ask for approval of each shell command of STUB_COMMANDS and run it if allowed

STUB_DUMP, if set, is a file the stub appends its environment and every line it reads to.
STUB_COMMANDS (verb mode) is a JSON list of shell commands. In each, {python}, {pyz} and {unit} stand for what the
prompt's header names as approved without asking: the interpreter, the archive and the unit, quoted as the header quotes
it. STUB_RESULT is the file that gets one JSON line for each answer: its behavior, its message and the exit code of the
command, which runs when it is allowed.
STUB_HANDLE, if set, makes the stub do what a page agent does with the items of a prompt: it runs `status <unit> done
<id>` for each item whose status is new, so that the driver sees the work done. Its value is the JSON list of the
command that runs a better verb, such as the interpreter and the archive.
STUB_LOG, if set, is a file the stub appends its process id, its BETTER_PAGE_SESSION and its command line to.
"""

import json
import os
import shlex
import subprocess
import sys
import time

MODE = os.environ.get("STUB_MODE", "ok")
VERSION = "2.0.1" if MODE == "old" else "2.1.400"


def say(message):
    print(json.dumps(message), flush=True)


def finish_turn(session):
    say(
        {
            "type": "assistant",
            "parent_tool_use_id": None,
            "message": {"content": [{"type": "text", "text": "ok"}]},
            "session_id": session,
        }
    )
    say({"type": "result", "subtype": "success", "is_error": False, "result": "ok", "session_id": session})


def header_form(prompt):
    """The interpreter, the archive and the quoted unit the prompt's header approves (S95)."""
    for line in prompt.splitlines():
        if line.startswith("Approved without asking: "):
            tokens = shlex.split(line.split("Approved without asking: ", 1)[1].split(", where")[0])
            return tokens[0], tokens[1], shlex.quote(tokens[3])
    return "python3", "better.pyz", "unit"


def prompt_text(message):
    content = message.get("message", {}).get("content", "")
    if isinstance(content, list):
        content = "".join(part.get("text", "") for part in content if isinstance(part, dict))
    return content


def run_commands(message):
    """Verb mode: each command is asked in turn, with the header's form filled in."""
    python, pyz, unit = header_form(prompt_text(message))
    for number, template in enumerate(json.loads(os.environ["STUB_COMMANDS"])):
        command = template.replace("{python}", shlex.quote(python)).replace("{pyz}", shlex.quote(pyz))
        command = command.replace("{unit}", unit)
        request = {"subtype": "can_use_tool", "tool_name": "Bash", "input": {"command": command, "description": "Run a page verb"}}
        say({"type": "control_request", "request_id": f"verb-{number}", "request": request})
        response = json.loads(sys.stdin.readline()).get("response", {}).get("response", {})
        code = None
        if response.get("behavior") == "allow":
            code = subprocess.run(["bash", "-c", command], capture_output=True, check=False).returncode
        answer = {"behavior": response.get("behavior"), "message": response.get("message"), "exit": code}
        with open(os.environ["STUB_RESULT"], "a") as result:
            result.write(json.dumps(answer) + "\n")


def handle_items(message):
    """STUB_HANDLE is the JSON list of the command that runs a verb (the source tree's, or an archive's)."""
    unit = header_form(prompt_text(message))[2]
    for line in prompt_text(message).splitlines():
        if line.startswith("{"):
            record = json.loads(line)
            if record.get("status") == "new" and record.get("id"):
                argv = [*json.loads(os.environ["STUB_HANDLE"]), "status", shlex.split(unit)[0], "done", record["id"]]
                subprocess.run(argv, capture_output=True, check=False)


def session_of(argv):
    for arg in argv:
        for flag in ("--session-id=", "--resume="):
            if arg.startswith(flag):
                return arg[len(flag) :]
    return "00000000-0000-4000-8000-000000000000"


def main(argv):
    if argv[1:] == ["--version"]:
        print(f"{VERSION} (Claude Code)")
        return 0
    if os.environ.get("STUB_LOG"):
        with open(os.environ["STUB_LOG"], "a") as log:
            log.write(f"{os.getpid()} {os.environ.get('BETTER_PAGE_SESSION')} {' '.join(argv)}\n")
    if os.environ.get("STUB_DUMP"):
        with open(os.environ["STUB_DUMP"], "a") as dump:
            dump.write(json.dumps(dict(os.environ)) + "\n")
    session = session_of(argv)
    turn = 0
    for line in sys.stdin:
        if os.environ.get("STUB_DUMP"):
            with open(os.environ["STUB_DUMP"], "a") as dump:
                dump.write(line)
        if MODE == "hang":
            time.sleep(600)
        try:
            message = json.loads(line)
        except ValueError:
            continue
        if message.get("type") == "control_request":
            subtype = message["request"].get("subtype")
            reply = {"request_id": message["request_id"], "subtype": "success", "response": {}}
            if subtype == "initialize":
                account = {} if MODE == "login" else {"subscriptionType": "pro"}
                reply["response"] = {
                    "claude_code_version": VERSION,
                    "current_permission_mode": "default",
                    "account": account,
                }
            say({"type": "control_response", "response": reply})
        elif message.get("type") == "control_response":
            finish_turn(session)  # the user answered the approval the stub asked for
        elif message.get("type") == "user":
            turn += 1
            say({"type": "system", "subtype": "init", "session_id": session, "permissionMode": "default"})
            if "--replay-user-messages" in argv and message.get("uuid"):
                # Claude Code echoes the prompt back with its uuid (tests/fixtures/page_wire/claude_2_1_332.json).
                say({**message, "session_id": session, "isReplay": True})
            if os.environ.get("STUB_HANDLE"):
                handle_items(message)
            if MODE == "verb" and turn == 1:
                run_commands(message)
                finish_turn(session)
                continue
            if MODE in ("ask", "cancel") and turn == 1:
                say(
                    {
                        "type": "control_request",
                        "request_id": "ask-1",
                        "request": {"subtype": "can_use_tool", "tool_name": "Bash", "input": {"command": "ls"}},
                    }
                )
                if MODE == "cancel":
                    time.sleep(1)
                    say({"type": "control_cancel_request", "request_id": "ask-1"})
                    finish_turn(session)
                continue  # the turn goes on once the approval is answered
            finish_turn(session)
    if MODE == "linger":
        time.sleep(600)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
