+
+
+def search_customers(conn, account_id, term):
+    """Return the account's customers whose name contains term."""
+    query = f"SELECT id, name FROM customers WHERE account_id = {account_id} AND name LIKE '%{term}%' ORDER BY name"
+    rows = conn.execute(query)
+    return [{"id": row[0], "name": row[1]} for row in rows]
